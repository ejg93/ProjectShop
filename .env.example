# 이 파일을 .env 로 복사해서 쓴다. .env 는 커밋되지 않는다.
POSTGRES_DB=shop
POSTGRES_USER=shop
POSTGRES_PASSWORD=shop
POSTGRES_PORT=5432
REDIS_PORT=6379
# Kafka 는 로컬 전용이다. 기본은 꺼짐(EVENTS_SINK=none) — 켤 때만 컨테이너를 띄운다.
KAFKA_PORT=9092
# 파일 저장소. 로컬은 S3Mock 컨테이너(콘솔 없음, 자격 증명 안 봄), 배포는 Cloudflare R2 다(둘 다 S3 호환이라 값만 갈린다).
# 버킷 만들기는 기본이 꺼짐(STORAGE_BOOTSTRAP=false) — 컨테이너를 띄운 로컬에서만 켠다.
# STORAGE_PORT 는 컴포즈의 포트 매핑만 바꾼다. 앱이 보는 것은 STORAGE_ENDPOINT 라
# 포트를 옮기면 둘을 같이 고친다(DB·Redis 와 다른 자리다).
STORAGE_PORT=9000
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=shop
STORAGE_SECRET_KEY=shopshop
# 웹훅 시크릿 키(`29`) — base64 32바이트. 비우면 웹훅 등록·발송만 503 이다. 만들기: openssl rand -base64 32
WEBHOOK_SECRET_KEY=
