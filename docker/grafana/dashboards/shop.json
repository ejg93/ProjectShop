{
  "uid": "projectshop",
  "title": "ProjectShop",
  "schemaVersion": 39,
  "time": { "from": "now-15m", "to": "now" },
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "권한 판정 p95",
      "description": "shop.permission.decide 의 95 백분위(SLO 버킷, `application.yml`). 판정이 캐시를 못 맞히면 오른다",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, source) (rate(shop_permission_decide_seconds_bucket[1m])))",
          "legendFormat": "{{source}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "오류율",
      "description": "shop.error.raised(ProblemFactory 가 낸 오류 응답) ÷ 전체 요청",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (source) (rate(shop_error_raised_total[1m])) / sum by (source) (rate(http_server_requests_seconds_count[1m]))",
          "legendFormat": "{{source}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "HTTP 응답 p95 — 경로별",
      "description": "http.server.requests 의 95 백분위(SLO 버킷). 부하 대조(`load-test.sh`)의 여섯 입구가 여기 보인다",
      "gridPos": { "x": 0, "y": 8, "w": 24, "h": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket[1m])))",
          "legendFormat": "{{uri}}"
        }
      ]
    }
  ]
}
