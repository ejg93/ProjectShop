<?xml version="1.0"?>
<!--
  PMD 가 보는 범주(`Q301`). **버그 패턴과 모범 관례 둘뿐이다** — 스타일·명명·설계 범주는 안 넣는다.
  스타일·차례는 Checkstyle 이 들고(`Q289`·`Q303`), 같은 것을 두 도구가 다르게 말하면 둘 다 안 읽게 된다.

  기존 지적은 `baseline.txt` 가 누르고 새 짝만 막는다(`build.gradle.kts` 의 `pmdBaseline`).
  규칙을 빼려면 줄마다 근거를 적는다 — 근거 없는 제외는 무엇을 막는지 아무도 모르게 만든다.
-->
<ruleset name="projectshop"
         xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">
    <description>ProjectShop — errorprone · bestpractices</description>

    <rule ref="category/java/errorprone.xml"/>
    <rule ref="category/java/bestpractices.xml"/>
</ruleset>
