<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
    "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
    "https://checkstyle.org/dtds/suppressions_1_2.dtd">
<!--
  선언 차례 검사(`DeclarationOrder`)에서 뺄 것. **한 줄마다 왜 뺐는지를 같이 적는다**
  (`coding-rules.md` 「선언 순서」) — 근거 없는 제외가 쌓이면 게이트가 무엇을 막는지 아무도 모른다.

  **영구**만 남았다 — `coding-rules.md` 의 예외 둘 중 하나를 댄 것이다.
  첫 측정(2026-10-21, 103건·54파일)의 기준선은 번들 15(`Q290a`~`Q290c`)가 다 지웠다.
  **새 줄은 근거가 있어야 한다** — 새 위반은 고치거나, 근거를 대고 영구 칸에 올린다.

  경로는 소스셋부터 적는다. 파일 이름만 쓰면 다른 패키지의 같은 이름까지 같이 숨는다.
-->
<suppressions>
    <!-- 영구 -->
    <!-- 규칙 필드 바로 밑에 그 규칙의 헬퍼를 둔 읽기 순서다. 차례대로 옮기면 헬퍼가 규칙과 떨어진다(`Q288`) -->
    <suppress checks="DeclarationOrder" files="test[\\/]java[\\/]com[\\/]projectshop[\\/]shop[\\/]ArchitectureTest\.java$"/>
    <!-- protected 컨테이너(`S3MOCK`)의 초기식이 package 이미지 이름·private 포트를 단순 이름으로 읽는다.
         접근자 차례대로 올리면 forward reference 로 컴파일이 깨진다(`Q290b`). 어떻게 풀지는 `Q291` -->
    <suppress checks="DeclarationOrder" files="test[\\/]java[\\/]com[\\/]projectshop[\\/]shop[\\/]StorageTestBase\.java$"/>
</suppressions>
