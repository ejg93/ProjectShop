<?xml version="1.0"?>
<!--
  Checkstyle 은 선언 차례 하나만 본다(`Q289`, `coding-rules.md` 「선언 순서」). 다른 모듈은 안 켠다 —
  켜면 그 모듈이 무엇을 막는지 따로 재야 하고, 재지 않은 게이트는 목록 전체를 안 읽게 만든다.

  **DOCTYPE 을 지우지 않는다.** 13.x 는 DOCTYPE 이 없으면 설정을 못 읽는다(`stack.md`).
  `localeLanguage=en` 은 메시지를 영어로 고정한다 — JVM 로케일이 ko 여도 출력 꼴이 안 바뀐다.
-->
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="localeLanguage" value="en"/>
    <property name="severity" value="error"/>

    <!-- 뺀 것은 한 줄마다 근거가 있다. 기준선은 줄이기만 한다 -->
    <module name="SuppressionFilter">
        <property name="file" value="${config_loc}/suppressions.xml"/>
    </module>

    <module name="TreeWalker">
        <!-- 기본값 그대로 — 종류 차례와 같은 종류 안 접근자 차례 둘 다(`Q288` 사용자 결정) -->
        <module name="DeclarationOrder"/>
    </module>
</module>
