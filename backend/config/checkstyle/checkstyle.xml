<?xml version="1.0"?>
<!--
  Checkstyle 은 선언 차례(`Q289`, `coding-rules.md` 「선언 순서」) · 안 쓰는 import(`Q303`) · 순환 복잡도(`Q304`) ·
  상수 Javadoc 「있음」(`Q378a`, `coding-rules.md` 「설정과 상수」) 넷을 본다.
  다른 모듈은 재기 전에 안 켠다 — 켜면 그 모듈이 무엇을 막는지 따로 재야 하고, 재지 않은 게이트는
  목록 전체를 안 읽게 만든다.

  **DOCTYPE 을 지우지 않는다.** 13.x 는 DOCTYPE 이 없으면 설정을 못 읽는다(`stack.md`).
  `localeLanguage=en` 은 메시지를 영어로 고정한다 — JVM 로케일이 ko 여도 출력 꼴이 안 바뀐다.
-->
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="localeLanguage" value="en"/>
    <property name="severity" value="error"/>

    <!-- 뺀 것은 한 줄마다 근거가 있다. 기준선은 줄이기만 한다 -->
    <module name="SuppressionFilter">
        <property name="file" value="${config_loc}/suppressions.xml"/>
    </module>

    <module name="TreeWalker">
        <!-- 기본값 그대로 — 종류 차례와 같은 종류 안 접근자 차례 둘 다(`Q288` 사용자 결정) -->
        <module name="DeclarationOrder"/>
        <!-- 안 쓰는 import(`Q303`). javadoc 을 안 읽는다 — Checkstyle 의 javadoc 문법이 한글 식별자
             (`{@link #바깥}`)를 못 읽어 위반으로 낸다(`stack.md`). javadoc 에만 쓰는 이름은 전체 이름으로 적는다 -->
        <module name="UnusedImports">
            <property name="processJavadoc" value="false"/>
        </module>
        <!-- 메서드 하나의 갈래 수(`Q304` 사용자 결정 — 15). 업무가 복잡한 것은 막지 않는다 — 메서드 하나에 모는 것을 막는다.
             10(기본값)은 갈래가 본질인 분류 코드를 억지로 쪼개게 해서 안 골랐다. 2026-10-25 첫 측정: 15 넘는 것 셋 -->
        <module name="CyclomaticComplexity">
            <property name="max" value="15"/>
        </module>
        <!-- 대문자 꼴 이름 필드(곧 상수) 옆의 「왜 이 값인가」(`Q378a`). Javadoc 꼴(`/** */`)만 센다 — `//` 줄 주석은
             있나를 재는 자리가 없어서 안 센다. 있나만 보고 내용은 안 읽어서 한글 식별자 함정에 안 걸린다.
             열거 상수는 뺐다(`tokens=VARIABLE_DEF`) — 열거값의 뜻은 「열거값을 어디에 두나」가 따로 다룬다.
             이름 패턴은 전체 일치라 대문자 상수 꼴이 아닌 필드·지역 변수는 다 빠진다 -->
        <module name="JavadocVariable">
            <property name="tokens" value="VARIABLE_DEF"/>
            <property name="ignoreNamePattern" value="^(?![A-Z][A-Z0-9_]*$).*"/>
        </module>
    </module>
</module>
